# SynapCores SOAR — docker-compose environment.
#
# Copy to .env and edit before `docker compose up`:
#   cp .env.example .env
#
# Required secrets are pre-populated with DEV-ONLY random values that
# satisfy validation so the 5-minute quickstart works on a fresh clone.
# ROTATE BEFORE ANY PRODUCTION OR INTERNET-FACING DEPLOY.

# ─── Engine secrets ────────────────────────────────────────────────

# JWT-signing secret the SynapCores engine uses for its own admin auth.
# Must be at least 32 characters. The value below is a random 48-byte
# string generated at the time this file was committed.
#
# Production: rotate with: openssl rand -base64 48
AIDB_JWT_SECRET=sipfY_mCHy7deRKFeamJ-Ls0DWNZU-OBMDjoaepN1Y4XXRfs8TaijYHb4ki_fpMZ

# Admin password pinned on the engine at first boot. Each app exchanges it for
# a gateway token at startup, so no token has to be copied by hand.
#
# Production: rotate with: openssl rand -base64 18 | tr -d /+=
AIDB_ADMIN_PASSWORD=5mf6aiSytBugLZBABiFf_mkD

# Optional. Leave blank and the apps mint their own token from
# AIDB_ADMIN_PASSWORD. Set it only to hand an app a narrower, scoped key.
SYNAPCORES_ADMIN_API_KEY=

# Admin Bearer token the SOAR app uses to call the engine.
# FIRST-BOOT FLOW: leave blank, run `docker compose up -d synapcores`,
# then grab the admin password from `docker compose logs synapcores`,
# log into http://localhost:28080, mint an admin API token, paste it
# here. Then `docker compose up -d soar`.

# ─── SOAR app secrets ──────────────────────────────────────────────

# Auth.js session-encryption secret. Must be at least 32 characters.
# Production: rotate with: openssl rand -base64 48
AUTH_SECRET=NbCp6fyOMPtYaIt6edMqP7shxRBHNgDJ0cjaD5bRBCQPiAEuqx3JeDPND2hWRCdY

# Public base URL for the SOAR app (Auth.js uses this for callback URLs).
SOAR_NEXTAUTH_URL=http://localhost:3001

# ─── Mail (invitations / magic-link login / password reset) ────────

# 'console' prints the URLs to stdout — fine for local dev.
# Production: set to 'resend' | 'ses' | 'smtp' and add the matching
# MAIL_RESEND_API_KEY / MAIL_AWS_REGION / MAIL_SMTP_* envs below.
MAIL_PROVIDER=console

# ─── SOAR triage dispatcher ────────────────────────────────────────

# How the Tier-1 triage agent runs:
#   auto     - try AGENT_RUN, fall back to deterministic rules if no LLM
#   agent    - require AGENT_RUN to succeed (an LLM must be configured)
#   fallback - skip the agent, deterministic rules only
SOAR_TRIAGE_MODE=auto
