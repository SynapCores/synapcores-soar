# SynapCores apps — root-level docker-compose env file.

# Required: JWT-signing secret the SynapCores engine uses for its own
# admin auth. Generate with: openssl rand -base64 32
AIDB_JWT_SECRET=replace-me-with-a-real-secret

# Required: the admin Bearer token the apps use to talk to the engine.
# After first-boot, log into the engine UI, mint an admin API token,
# paste it here.
SYNAPCORES_ADMIN_API_KEY=replace-me-after-first-boot

# Required: Auth.js session-encryption secret. 32 random bytes.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-random-bytes

# Public base URL for each app (used by Auth.js for callback URLs).
SOAR_NEXTAUTH_URL=http://localhost:3001
AML_NEXTAUTH_URL=http://localhost:3003

# Mail provider for invitations + magic links + password reset.
# 'console' prints URLs to stdout (dev). Set to 'resend' | 'ses' |
# 'smtp' in production.
MAIL_PROVIDER=console

# SOAR triage dispatcher mode.
#   'auto'     - try AGENT_RUN, fallback to deterministic if no LLM
#   'agent'    - require AGENT_RUN to succeed (LLM must be configured)
#   'fallback' - skip the agent, use deterministic rules
SOAR_TRIAGE_MODE=auto

# AML triage + SAR-drafter mode (same semantics as SOAR_TRIAGE_MODE).
AML_TRIAGE_MODE=auto

# Default SAR jurisdiction for new drafts.
#   us-fincen | uk-nca | au-austrac | ca-fintrac | eu-goaml
AML_DEFAULT_JURISDICTION=us-fincen
