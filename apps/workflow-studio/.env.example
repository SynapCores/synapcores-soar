# --------------------------------------------------------------------
# Workflow Studio — local .env.example
# Copy this file to .env.local, fill in the real values, then run:
#   pnpm --filter @synapcores/workflow-studio dev
# --------------------------------------------------------------------

# --- Auth.js (REQUIRED) ---------------------------------------------
# Random 32+ byte secret used to sign session cookies. Without it the
# server boots but every login fails with "There was a problem with
# the server configuration" (MissingSecret in the dev log).
# Generate locally:  openssl rand -base64 48
AUTH_SECRET=change-me-replace-with-openssl-rand-base64-48-output

# Public origin Auth.js mints redirect targets against. Match exactly
# how you'll reach the app in the browser — including the port.
NEXTAUTH_URL=http://localhost:3010

# Trust the proxy / origin Auth.js sees. Required in any non-default
# deployment (Docker, Vercel preview, reverse proxy). Safe in dev too.
AUTH_TRUST_HOST=true

# --- SynapCores engine (REQUIRED) -----------------------------------
# Base URL of the SynapCores engine the studio compiles workflows
# against and executes them on. Run the engine first:
#   docker run -d -p 8080:8080 \
#     -e AIDB_ACCEPT_LICENSE=1 \
#     -v synapcores-data:/var/lib/synapcores \
#     synapcores/community:latest
# Then point the studio at it. Mind the port — the engine listens on
# 8080 / 28080 depending on how you started it.
SYNAPCORES_URL=http://127.0.0.1:8080

# Admin JWT or API key for the engine. The studio uses this for
# bootstrap (creating the studio's own user / workflow tables) and
# for engine-side workflow execution. Both names are accepted —
# `SYNAPCORES_API_KEY` is the canonical one, the `_ADMIN_` alias is
# for symmetry with other SynapCores SDKs.
SYNAPCORES_API_KEY=replace-with-engine-admin-token
SYNAPCORES_ADMIN_API_KEY=replace-with-engine-admin-token

# --- Bootstrap defaults (OPTIONAL) ----------------------------------
# Only read by `pnpm bootstrap` on first run. Change them BEFORE
# the seed runs — the resulting admin user cannot have its password
# rotated through the UI in this alpha.
STUDIO_ADMIN_EMAIL=admin@localhost
STUDIO_ADMIN_PASSWORD=change-me-now
