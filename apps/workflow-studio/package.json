{
  "name": "@synapcores/workflow-studio",
  "version": "0.1.0-alpha",
  "description": "SynapCores Workflow Studio — visual agentic workflow builder. Compiles drag-and-drop workflows to SQL and deploys to a SynapCores engine.",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start --port 3010",
    "bootstrap": "node ./bin/bootstrap.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "compile": "node ./bin/workflow-studio.mjs compile",
    "studio": "node ./bin/workflow-studio.mjs"
  },
  "dependencies": {
    "@synapcores/app-framework": "workspace:*",
    "@synapcores/workflow-types": "workspace:*",
