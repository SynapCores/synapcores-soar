# Where the SynapCores engine is reachable.
# Local dev: same machine.
# Managed cloud / docker compose: synapcores hostname inside the network.
SYNAPCORES_URL=http://127.0.0.1:28080

# The control-plane admin API key the framework uses to read/write
# the framework's tenancy + user + audit tables. Mint this once in
# SynapCores admin and store in a real secret manager in production.
SYNAPCORES_ADMIN_API_KEY=replace-me-with-a-real-key

# Where the framework persists per-tenant SynapCores API keys.
# Production: swap for a real secret manager.
FRAMEWORK_TENANT_KEYS_DIR=./var/tenant-keys

# Auth.js session-encryption secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-random-bytes

# Public base URL of this app — used by Auth.js for callback URLs.
NEXTAUTH_URL=http://localhost:3001
