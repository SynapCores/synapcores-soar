# telemetry-bridge env

# Reuse the same SynapCores AIDB the aerospace-rca app talks to.
SYNAPCORES_URL=http://127.0.0.1:8081
SYNAPCORES_ADMIN_API_KEY=eyJ0eXAiOi...   # paste the same JWT used in apps/aerospace-rca/.env.local

DCU_BRIDGE_PORT=4005
DCU_AGGREGATE_PERIOD_MS=5000
DCU_BATCH_ROWS=500
# Set to 0 to skip writing 1Hz / 0.2Hz aggregates (alerts + promoted
# anomalies still flow). Keep at 1 for the full demo.
DCU_PERSIST_AGGREGATES=1
