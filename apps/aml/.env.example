SYNAPCORES_URL=http://127.0.0.1:28080
SYNAPCORES_ADMIN_API_KEY=replace-me-with-a-real-key
FRAMEWORK_TENANT_KEYS_DIR=./var/tenant-keys
AUTH_SECRET=replace-me-with-32-random-bytes
NEXTAUTH_URL=http://localhost:3003
MAIL_PROVIDER=console

# AML triage dispatcher mode.
#   'auto'     - try AGENT_RUN, fallback to deterministic if no LLM
#   'agent'    - require AGENT_RUN to succeed (LLM must be configured)
#   'fallback' - skip the agent, use deterministic rules-based triage
AML_TRIAGE_MODE=auto

# Jurisdiction for SAR-template defaults.
#   us-fincen | uk-nca | au-austrac | ca-fintrac | eu-goaml
AML_DEFAULT_JURISDICTION=us-fincen
